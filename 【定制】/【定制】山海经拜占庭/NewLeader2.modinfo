  <ActionCriteria>
    <Criteria id="NewLeader2">
      <LeaderPlayable>Players:StandardPlayers::LEADER_BASIL_ALT,StandardPlayers::LEADER_BASIL_ALT,Players:Expansion1_Players::LEADER_BASIL_ALT,Players:Expansion2_Players::LEADER_BASIL_ALT</LeaderPlayable>
      <RuleSetInUse>RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
    <Criteria id="NewLeader2_Expansion1">
      <LeaderPlayable>Players:Expansion1_Players::LEADER_BASIL_ALT</LeaderPlayable>
      <RuleSetInUse>RULESET_EXPANSION_1</RuleSetInUse>
    </Criteria>
    <Criteria id="NewLeader2_Expansion2">
      <LeaderPlayable>Players:Expansion2_Players::LEADER_BASIL_ALT</LeaderPlayable>
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
    </Criteria>
    <Criteria id="SecretSocieties">
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
