        </Criteria>
        <Criteria id="Map_TPT_RichNS" any="1">
            <ConfigurationValueMatches>
                <Group>Map</Group>
                <ConfigurationId>MAP_SCRIPT</ConfigurationId>
                <Value>TPT_RichNS.lua</Value>
            </ConfigurationValueMatches>
            <ConfigurationValueMatches>
                <Group>Map</Group>
                <ConfigurationId>MAP_SCRIPT</ConfigurationId>
                <Value>TPT_RichNSRiver.lua</Value>
            </ConfigurationValueMatches>
        </Criteria>

