            <ConfigurationValueMatches>
                <Group>Map</Group>
                <ConfigurationId>MAP_SCRIPT</ConfigurationId>
                <Value>TPT_RichNS.lua</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Map_IS_TPT_RichNSRiver">
            <ConfigurationValueMatches>
                <Group>Map</Group>
                <ConfigurationId>MAP_SCRIPT</ConfigurationId>
                <Value>TPT_RichNSRiver.lua</Value>
            </ConfigurationValueMatches>
        </Criteria>

        <Criteria id="MapTrait">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>MapTrait</ConfigurationId>
                <Value>1</Value>
