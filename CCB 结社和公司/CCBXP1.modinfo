<?xml version="1.0" encoding="utf-8"?>
<Mod id="ffffffff-ffff-ffff-ffff-0001ffff0001" version="1">
    <Properties>
        <Name>CCB [COLOR:Civ6Yellow]结社与行业[ENDCOLOR]</Name>
        <Description>CCB 结社与行业</Description>
        <Created>1745481858</Created>
        <Teaser>CCB 结社与行业</Teaser>
        <Authors>千川白浪</Authors>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
    </Properties>
    <ActionCriteria>
        <Criteria id="SecretSocieties">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
        <Criteria id="Monopolies">
            <ConfigurationValueMatches>
                <Group>Game</Group>
                <ConfigurationId>GAMEMODE_MONOPOLIES</ConfigurationId>
                <Value>1</Value>
            </ConfigurationValueMatches>
        </Criteria>
    </ActionCriteria>
    <FrontEndActions>
        <UpdateDatabase id="CCBXP1_UpdateDatabase">
            <Properties>
                <LoadOrder>5</LoadOrder>
            </Properties>
            <File>CCBXP1_Config.sql</File>
        </UpdateDatabase>

        <!-- 垄断 -->
        <UpdateText id="Monopolies_Localization">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <File>Monopolies/Monopolies_Localization.xml</File>
        </UpdateText>

        <!-- 结社 -->
        <UpdateArt id="SecretSocieties_UpdateArt">
            <File>SecretSocieties/Buildings.artdef</File>
        </UpdateArt>
        <UpdateText id="SecretSocieties_UpdateText">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <File>SecretSocieties/SecretSocieties_Text.xml</File>
        </UpdateText>
    </FrontEndActions>
    <InGameActions>
        <UpdateDatabase id="CCBXP1_Database">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <File>CCBXP1.sql</File>
        </UpdateDatabase>

        <!-- 垄断 -->
        <UpdateDatabase id="Monopolies_Database">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <Criteria>Monopolies</Criteria>
            <File>Monopolies/Monopolies.sql</File>
        </UpdateDatabase>
        <UpdateText id="Monopolies_Localization">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <Criteria>Monopolies</Criteria>
            <File>Monopolies/Monopolies_Localization.xml</File>
        </UpdateText>

        <!-- 结社 -->
        <UpdateArt id="SecretSocieties_UpdateArt">
            <File>SecretSocieties/Buildings.artdef</File>
        </UpdateArt>
        <UpdateDatabase id="SecretSocieties">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <Criteria>SecretSocieties</Criteria>
            <File>SecretSocieties/Build_shipYard.xml</File>
            <File>SecretSocieties/SecretSocieties.sql</File>
        </UpdateDatabase>
        <UpdateIcons id="SecretSocieties_Icons">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <Criteria>SecretSocieties</Criteria>
            <File>SecretSocieties/SecretSocieties_Icons.xml</File>
        </UpdateIcons>
        <UpdateText id="SecretSocieties_Text">
            <Properties>
                <LoadOrder>1679659</LoadOrder>
            </Properties>
            <Criteria>SecretSocieties</Criteria>
            <File>SecretSocieties/SecretSocieties_Text.xml</File>
        </UpdateText>
    </InGameActions>
    <Files>
        <File>CCBXP1.sql</File>
        <File>CCBXP1_Config.sql</File>

        <File>Monopolies/Monopolies.sql</File>
