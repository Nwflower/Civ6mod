<Mod id="d2a7e909-410b-4999-4555-61f3652896b1" version="1">
  <Properties>
    <Name>【定制】[COLOR:Civ6Yellow]人类玩家冻土可改田、移除海滩遗址[ENDCOLOR]</Name>
    <Description>人类玩家冻土初始可改农田、土木工程后可在冻土丘陵上改农田。移除海滩遗址和历史古迹。</Description>
    <Created>1745481858</Created>
    <Teaser>冻土可改田、移除海滩遗址</Teaser>
    <Authors>千川白浪</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <UpdateDatabase id="FishPicks">
      <Properties>
        <LoadOrder>500000</LoadOrder>
      </Properties>
      <File>FishPicks.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>FishPicks.sql</File>
  </Files>
</Mod>